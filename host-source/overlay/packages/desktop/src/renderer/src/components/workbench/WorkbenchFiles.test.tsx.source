// @vitest-environment happy-dom
import * as React from "react";
import { act } from "react";
import { createRoot, type Root } from "react-dom/client";
import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";

const api = vi.hoisted(() => ({
	workbenchListFiles: vi.fn(),
	workbenchReadFile: vi.fn(),
}));

vi.mock("../../api", () => ({ getPi: () => api }));
vi.mock("../../i18n", () => ({ useT: () => (key: string) => key }));

import type { WorkbenchFileEntry } from "./types";
import { WorkbenchFiles } from "./WorkbenchFiles";

const deferred = <T,>() => {
	let resolve!: (value: T) => void;
	let reject!: (reason: unknown) => void;
	const promise = new Promise<T>((res, rej) => {
		resolve = res;
		reject = rej;
	});
	return { promise, resolve, reject };
};

const rootEntries: WorkbenchFileEntry[] = [
	{ name: "src", path: "/project/src", directory: true },
	{ name: "a.txt", path: "/project/a.txt", directory: false },
	{ name: "b.txt", path: "/project/b.txt", directory: false },
];

let host: HTMLDivElement;
let root: Root;

const buttonByText = (text: string) =>
	[...host.querySelectorAll("button")].find((button) => button.textContent?.trim() === text);

beforeEach(() => {
	vi.stubGlobal("IS_REACT_ACT_ENVIRONMENT", true);
	vi.stubGlobal("React", React);
	vi.clearAllMocks();
	api.workbenchListFiles.mockResolvedValue(rootEntries);
	api.workbenchReadFile.mockResolvedValue({
		path: "/project/a.txt",
		kind: "text",
		content: "A CONTENT",
		truncated: false,
	});
	host = document.createElement("div");
	document.body.append(host);
	root = createRoot(host);
});

afterEach(async () => {
	await act(async () => root.unmount());
	host.remove();
	vi.unstubAllGlobals();
});

const render = async (sessionId = "session") =>
	act(async () => {
		root.render(<WorkbenchFiles sessionId={sessionId} />);
		await Promise.resolve();
	});

describe("WorkbenchFiles", () => {
	it("lists the workspace and lazily expands directories", async () => {
		const children = deferred<WorkbenchFileEntry[]>();
		api.workbenchListFiles.mockResolvedValueOnce(rootEntries).mockReturnValueOnce(children.promise);
		await render();
		expect(api.workbenchListFiles).toHaveBeenCalledWith({ sessionId: "session" });
		expect(buttonByText("a.txt")).toBeDefined();

		await act(async () => {
			buttonByText("src")?.dispatchEvent(new MouseEvent("click", { bubbles: true }));
		});
		expect(api.workbenchListFiles).toHaveBeenCalledWith({
			sessionId: "session",
			path: "/project/src",
		});
		expect(host.textContent).toContain("workbench.filesLoading");

		await act(async () => {
			children.resolve([{ name: "index.ts", path: "/project/src/index.ts", directory: false }]);
			await children.promise;
		});
		expect(buttonByText("index.ts")).toBeDefined();
	});

	it("ignores a late file response after another file is selected", async () => {
		const first = deferred<{
			path: string;
			kind: "text";
			content: string;
			truncated: boolean;
		}>();
		const second = deferred<{
			path: string;
			kind: "text";
			content: string;
			truncated: boolean;
		}>();
		api.workbenchReadFile.mockImplementation(({ path }: { path: string }) =>
			path.endsWith("a.txt") ? first.promise : second.promise,
		);
		await render();

		await act(async () => {
			buttonByText("a.txt")?.dispatchEvent(new MouseEvent("click", { bubbles: true }));
		});
		await act(async () => {
			buttonByText("b.txt")?.dispatchEvent(new MouseEvent("click", { bubbles: true }));
		});
		await act(async () => {
			first.resolve({
				path: "/project/a.txt",
				kind: "text",
				content: "A CONTENT",
				truncated: false,
			});
			await first.promise;
		});
		expect(host.textContent).not.toContain("A CONTENT");

		await act(async () => {
			second.resolve({
				path: "/project/b.txt",
				kind: "text",
				content: "B CONTENT",
				truncated: false,
			});
			await second.promise;
		});
		expect(host.textContent).toContain("B CONTENT");
	});

	it("drops pending responses when the session changes", async () => {
		const first = deferred<{
			path: string;
			kind: "text";
			content: string;
			truncated: boolean;
		}>();
		api.workbenchReadFile.mockReturnValue(first.promise);
		await render("one");
		await act(async () => {
			buttonByText("a.txt")?.dispatchEvent(new MouseEvent("click", { bubbles: true }));
		});

		api.workbenchListFiles.mockResolvedValue([]);
		await render("two");
		await act(async () => {
			first.resolve({
				path: "/project/a.txt",
				kind: "text",
				content: "OLD SESSION",
				truncated: false,
			});
			await first.promise;
		});
		expect(host.textContent).not.toContain("OLD SESSION");
		expect(host.textContent).toContain("workbench.filesEmpty");
	});
});
