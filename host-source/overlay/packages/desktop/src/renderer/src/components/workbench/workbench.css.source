/* Workbench: a real flex sibling of the chat column, never an overlay. */
.workbench-pane {
	position: relative;
	flex: none;
	min-width: 0;
	overflow: hidden;
	background: var(--color-canvas);
	border-left: 1px solid var(--color-border);
}

.workbench-pane.is-resizing {
	transition: none;
}

.workbench-pane-inner {
	height: 100%;
	min-width: 0;
	display: flex;
	flex-direction: column;
	overflow: hidden;
}

.workbench-pane.is-collapsed .workbench-pane-inner {
	visibility: hidden;
}

.workbench-resize-handle {
	position: absolute;
	z-index: 2;
	top: 0;
	bottom: 0;
	left: 0;
	width: 8px;
	height: auto;
	margin: 0;
	border: 0;
	cursor: col-resize;
	touch-action: none;
	outline: none;
}

.workbench-resize-handle::before {
	content: "";
	position: absolute;
	inset: 0 auto 0 0;
	width: 1px;
	background: var(--color-border);
	transition: background 0.15s ease;
}

.workbench-resize-handle:hover::before,
.workbench-resize-handle:focus-visible::before,
.workbench-pane.is-resizing .workbench-resize-handle::before {
	width: 2px;
	background: var(--color-ink-faint);
}

.workbench-webview {
	width: 100%;
	height: 100%;
}

@media (prefers-reduced-motion: reduce) {
	.workbench-pane,
	.workbench-pane-inner {
		transition: none;
	}
}
